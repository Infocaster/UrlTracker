{
  "name": "urltracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && tsc && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint-fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "api:generate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-ts"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@oddbird/popover-polyfill": "^0.7.1",
    "chart.js": "^4.5.1",
    "js-cookie": "^3.0.8",
    "lit": "^3.3.3",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@umbraco-cms/backoffice": "^18.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit-a11y": "^4.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
