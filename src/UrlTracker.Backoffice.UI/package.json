{
  "name": "urltracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && tsc && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint-fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "api:generate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-ts"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "^0.85.2",
    "@lit/context": "^1.1.1",
    "@lit/task": "^1.0.3",
    "@oddbird/popover-polyfill": "^0.4.3",
    "@umbraco-ui/uui-boolean-input": "^1.8.2",
    "@umbraco-ui/uui-file-dropzone": "^1.8.0",
    "@umbraco-ui/uui-icon-registry": "^1.15.0",
    "@umbraco-ui/uui-input": "^1.7.1",
    "@umbraco-ui/uui-pagination": "^1.7.1",
    "axios": "^1.15.2",
    "chart.js": "^4.4.3",
    "js-cookie": "^3.0.5",
    "lit": "^3.1.3",
    "qs": "^6.12.3"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/qs": "^6.9.15",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@umbraco-cms/backoffice": "^17.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit-a11y": "^4.1.2",
    "prettier": "^3.2.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
