<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>UrlTracker.Backoffice.UI</PackageId>
    <Title>URL Tracker Backoffice interface</Title>
    <Description>This package adds a backoffice interface for URL Tracker management</Description>
    <RootNamespace>UrlTracker.Backoffice.UI</RootNamespace>
    <StaticWebAssetBasePath>App_Plugins/UrlTracker</StaticWebAssetBasePath>
    <PackageReleaseNotes>4 new features, 1 bugfix, 3 other changes

- Fix untranslated text on the content picker in the redirect edit panel
- Add create date to the redirects on the overview
- Add the date of the first and last occurrance of a recommendation
- Add global deny list package as default plugin
- Disable the redirect source condition while solving a recommendation
- Remove company logo
- Include more technical words for recognition
- The label above the top recommendations now matches the displayed amount</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build\**\*.*">
      <Pack>True</Pack>
      <PackagePath>buildTransitive</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UrlTracker.IntegrationTests" />
    <InternalsVisibleTo Include="UrlTracker.Backoffice.UI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="package-lock.json" />
    <Content Remove="package.json" />
    <Content Remove="tsconfig.json" />
    <None Include="package-lock.json" />
    <None Include="package.json" />
    <None Include="tsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.5" />
    <PackageReference Include="Umbraco.Cms.Core" Version="13.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UrlTracker.Core\UrlTracker.Core.csproj" />
    <ProjectReference Include="..\UrlTracker.Modules\UrlTracker.Modules.csproj" />
  </ItemGroup>
</Project>