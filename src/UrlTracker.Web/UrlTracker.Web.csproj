<Project Sdk="Microsoft.NET.Sdk">
  <!-- Package properties -->
  <PropertyGroup>
    <PackageId>UrlTracker.Web</PackageId>
    <Title>URL Tracker Web</Title>
    <Description>This package contains the web services for the URL Tracker. Useful for package development.</Description>
    <RootNamespace>UrlTracker.Web</RootNamespace>
    <PackageReleaseNotes>4 new features, 1 bugfix, 3 other changes

- Fix untranslated text on the content picker in the redirect edit panel
- Add create date to the redirects on the overview
- Add the date of the first and last occurrance of a recommendation
- Add global deny list package as default plugin
- Disable the redirect source condition while solving a recommendation
- Remove company logo
- Include more technical words for recognition
- The label above the top recommendations now matches the displayed amount</PackageReleaseNotes>
  </PropertyGroup>
  <!-- END Package properties -->
  <!-- External references -->
  <ItemGroup>
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="10.6.1" />
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="10.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UrlTracker.Core\UrlTracker.Core.csproj" />
  </ItemGroup>
  <!-- END External references -->
  <!-- Exclusions -->
  <ItemGroup>
    <Compile Remove="node_modules\**" />
    <EmbeddedResource Remove="node_modules\**" />
    <None Remove="node_modules\**" />
  </ItemGroup>
  <!-- END Exclusions -->
</Project>